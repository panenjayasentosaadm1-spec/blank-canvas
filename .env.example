# Environment variables used by this app.
# All of these are build-time only (VITE_* is inlined into the client bundle);
# the app reads no process.env variables at runtime, so none need to be set
# in the Cloudflare dashboard while it runs on mock data.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
